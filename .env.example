# =============================================================================
# Gest_POV — variables d'environnement (modèle)
#
# Usage :
#   cp .env.example .env
#   # Remplacer TOUS les <REMPLACER_...> par des valeurs réelles
#   # Ne JAMAIS committer .env
#
# Ce fichier ne contient AUCUN mot de passe ni secret réel.
#
# Contextes :
#   A) Docker CLIENT (production) — renseigner ce fichier complet
#   B) Dev local Web — voir docs/lancement-dev.md (profil "dev")
#   C) Desktop Windows — voir desktop/docs/environment-variables.md
# =============================================================================

# =============================================================================
# A) POSTGRESQL (conteneur Docker)
# =============================================================================
POSTGRES_DB=erp_products
POSTGRES_USER=erp_user

# Mot de passe PostgreSQL — OBLIGATOIRE en client. Ce n'est PAS un secret réel.
# Générer : openssl rand -base64 24
POSTGRES_PASSWORD=<REMPLACER_PAR_MOT_DE_PASSE_POSTGRES_FORT>

# Exposition PostgreSQL sur l'hôte (admin local uniquement)
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# =============================================================================
# B) SPRING BOOT (service backend dans Docker)
# =============================================================================
SPRING_PROFILES_ACTIVE=prod,docker

# URL JDBC — hôte "postgres" = nom du service Compose (pas 127.0.0.1)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/erp_products
SPRING_DATASOURCE_USERNAME=erp_user
SPRING_DATASOURCE_PASSWORD=<REMPLACER_PAR_MOT_DE_PASSE_POSTGRES_FORT>

# =============================================================================
# C) SÉCURITÉ APPLICATION
# =============================================================================
# Clé JWT — min. 32 caractères aléatoires. PAS une clé réelle.
# Doit rester identique entre redémarrages.
# Générer : openssl rand -base64 32
APP_JWT_SECRET=<REMPLACER_PAR_CLE_JWT_ALEATOIRE_MIN_32_CARACTERES>

# =============================================================================
# D) PREMIER ADMINISTRATEUR (installation vierge, profil prod)
# =============================================================================
APP_BOOTSTRAP_ADMIN_EMAIL=admin@votre-entreprise.example
APP_BOOTSTRAP_ADMIN_PASSWORD=<REMPLACER_PAR_MOT_DE_PASSE_ADMIN_FORT>
APP_BOOTSTRAP_ADMIN_NAME=Administrateur
APP_BOOTSTRAP_ADMIN_LAST_NAME=ERP

# =============================================================================
# E) ACCÈS APPLICATION (reverse proxy Caddy)
# =============================================================================
APP_BIND=127.0.0.1
APP_PORT=80
FRONTEND_PORT=80

# =============================================================================
# F) IMAGES PRÉ-BUILDÉES (deploy/compose.client.images.yml)
# =============================================================================
BACKEND_IMAGE=gest-pov-backend:1.0.0
FRONTEND_IMAGE=gest-pov-frontend:1.0.0

# =============================================================================
# G) OPTIONNEL
# =============================================================================
# BACKEND_PORT=8080
# VITE_API_BASE=/api
