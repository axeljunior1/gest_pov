# Modele pour backend/.env — copier en ".env" et remplir avec de vraies valeurs.
# Charge automatiquement par ProductsApplication au demarrage (mvn spring-boot:run),
# uniquement pour un lancement local hors Docker. N'a aucun effet dans le conteneur
# Docker (qui recoit ses propres variables via docker-compose.yml / .env racine).

SPRING_PROFILES_ACTIVE=prod

# Doit correspondre au Postgres reellement utilise (ex: conteneur Docker expose sur
# 127.0.0.1:5432 via docker-compose.yml) et aux identifiants du .env racine du repo.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/erp_products
SPRING_DATASOURCE_USERNAME=erp_user
SPRING_DATASOURCE_PASSWORD=change-me

APP_JWT_SECRET=change-me-min-256-bits-long-key

# Premier demarrage uniquement (base vide) : cree le compte admin initial.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=Admin
APP_BOOTSTRAP_ADMIN_LAST_NAME=ERP
